# ============================================================
#  Variables de entorno - BACKEND (Spring Boot)
# ============================================================

# Puerto del servidor
PORT=8080

# Base de datos (PostgreSQL en la nube / SQL Server en local)
DB_URL=jdbc:postgresql://USUARIO:CONTRASENA@HOST:5432/escolar
DB_USER=escolar
DB_PASSWORD=CONTRASENA
DB_DRIVER=org.postgresql.Driver

# Esquema: validate en local (solo verifica), update en la nube (crea las tablas)
DDL_AUTO=validate

# Orígenes permitidos (separados por coma). Debe incluir el dominio del frontend.
CORS_ORIGENES=http://localhost:3000,https://escolar-frontend.onrender.com

# Clave de firma de los tokens JWT (minimo 32 caracteres)
JWT_SECRET=cambia-esta-clave-por-una-secreta-de-al-menos-32-caracteres

# Minutos de validez del token
JWT_EXPIRACION_MINUTOS=480

# Carpeta de archivos subidos
ARCHIVOS_RUTA=./archivos
